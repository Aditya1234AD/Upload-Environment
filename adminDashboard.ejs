<h2>Admin Dashboard</h2>
<% users.forEach(user => { %>
  <div style="margin-bottom:20px">
    <h3><%= user.username %></h3>
    <% if (user.photo) { %>
      <img src="/uploads/<%= user.photo %>" width="100" />
      <p>Name: <%= user.details.name %></p>
      <p>Village: <%= user.details.village %></p>
      <p>District: <%= user.details.district %></p>
    <% } else { %>
      <p>No details submitted yet</p>
    <% } %>
  </div>
<% }) %>